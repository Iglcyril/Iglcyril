  <!-- Floating code fragments left -->
  <text x="18" y="28" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.25">int main(void)</text>
  <text x="10" y="52" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.18">#include &lt;stdio.h&gt;</text>
  <text x="22" y="75" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.20">nmap -sV 192.168.1.0/24</text>
  <text x="8" y="98" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.15">while(1) { scan(); }</text>
  <text x="14" y="122" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.22">chmod 777 exploit.sh</text>
  <text x="6" y="145" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.17">def crack(hash):</text>
  <text x="18" y="168" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.20">ssh root@10.0.0.1</text>
  <text x="10" y="192" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.14">cat /etc/shadow</text>

  <!-- Floating code fragments right -->
  <text x="490" y="28" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.18">wireshark -i eth0</text>
  <text x="510" y="52" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.22">printf("%p\n", ptr);</text>
  <text x="498" y="75" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.15">GET / HTTP/1.1</text>
  <text x="520" y="98" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.20">SELECT * FROM users;</text>
  <text x="505" y="122" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.17">sudo ./pwn.sh</text>
  <text x="488" y="145" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.23">nc -lvnp 4444</text>
  <text x="514" y="168" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.16">hashcat -m 0 hash.txt</text>
  <text x="500" y="192" font-family="monospace" font-size="9" fill="#00FF41" opacity="0.19">return 0;</text>

  <!-- Glow effect behind main text -->
  <text x="340" y="118" font-family="monospace" font-size="82" font-weight="700" fill="#00FF41" opacity="0.06" text-anchor="middle">CYRIL</text>
  <text x="340" y="118" font-family="monospace" font-size="82" font-weight="700" fill="#00FF41" opacity="0.06" text-anchor="middle">CYRIL</text>

  <!-- Main title -->
  <text x="340" y="118" font-family="monospace" font-size="82" font-weight="700" fill="#00FF41" opacity="0.95" text-anchor="middle">CYRIL</text>

  <!-- Subtitle -->
  <text x="340" y="148" font-family="monospace" font-size="13" fill="#00FF41" opacity="0.7" text-anchor="middle" letter-spacing="4">CYBERSECURITY STUDENT  |  CTF PLAYER</text>

  <!-- Bottom line -->
  <line x1="180" y1="162" x2="500" y2="162" stroke="#00FF41" stroke-width="0.5" opacity="0.4"/>

  <!-- Bottom prompt -->
  <text x="340" y="180" font-family="monospace" font-size="11" fill="#00FF41" opacity="0.5" text-anchor="middle">&gt; Connection established. Stay curious. Stay ethical.</text>

  <!-- Corner brackets decoration -->
  <path d="M20,10 L20,4 L26,4" stroke="#00FF41" stroke-width="1" fill="none" opacity="0.5"/>
  <path d="M660,10 L660,4 L654,4" stroke="#00FF41" stroke-width="1" fill="none" opacity="0.5"/>
  <path d="M20,210 L20,216 L26,216" stroke="#00FF41" stroke-width="1" fill="none" opacity="0.5"/>
  <path d="M660,210 L660,216 L654,216" stroke="#00FF41" stroke-width="1" fill="none" opacity="0.5"/>
</svg>
